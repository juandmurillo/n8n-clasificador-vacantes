      ],
      "webhookId": "a1000000-0000-4000-8000-0000000000aa"
    },
    {
      "parameters": {
        "jsCode": "const MAX_CARACTERES = 20000;\n// El webhook envía body.texto; el chat envía chatInput.\nconst entrada = $input.first().json;\nconst texto = entrada.body?.texto ?? entrada.chatInput;\n\nlet error = null;\nif (typeof texto !== 'string' || texto.trim() === '') {\n  error = 'El campo \"texto\" es obligatorio y no puede estar vacío.';\n} else if (texto.length > MAX_CARACTERES) {\n  error = `El campo \"texto\" supera el máximo de ${MAX_CARACTERES} caracteres.`;\n}\n\nreturn [{ json: { valido: error === null, error, texto: error ? null : texto.trim() } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Validar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.valido }}",
              "rightValue": "",
              "operator": {
