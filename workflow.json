{
  "name": "Clasificador de vacantes",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vacante",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
